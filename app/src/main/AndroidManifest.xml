<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Android 11+ 的包可见性：getPackageInfo / getPackagesForUid 默认看不到目标应用，
        状态卡与 StatusProvider 的 UID 校验会误判。必须显式声明。
    -->
    <queries>
        <package android:name="com.sina.weibo" />
    </queries>

    <application
        android:allowBackup="false"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.QuietWeibo">

        <!--
            开关页把配置写进框架的 remote preferences。此前只写模块自己的 MODE_PRIVATE，
            微博进程读不到，导致所有开关都不生效。
            authority 必须是 <applicationId>.XposedService，这是 libxposed service 的约定；
            官方 XposedProvider 是 final 且其回调入口是包内可见，所以直接用它，不包一层。
        -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!--
            诊断数据通道：目标进程的 HookState 经 hooks/Report 把 reg/hit/skip 回传到这里。
            方向不能反过来——remote prefs 和 openRemoteFile 在目标进程都是只读。
            authority 与 StatusProvider.AUTHORITY 必须一致。
        -->
        <provider
            android:name=".StatusProvider"
            android:authorities="${applicationId}.status"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!--
            MainActivity 同时承担两个入口：
            1. MODULE_SETTINGS：LSPosed 管理器里「打开」模块时使用；
            2. activity-alias LauncherEntry 的 targetActivity：桌面/抽屉图标。
            隐藏图标只禁用 alias，MainActivity 本身仍在，不会把设置页锁在外面。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="com.quietweibo.app.LauncherEntry"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
